func _ready() -> void:
	_register_inputs()


## 代码注册输入映射，缺哪个补哪个，不覆盖用户已有配置。
func _register_inputs() -> void:
	# 游戏操作键：**只有三个** —— 上（跳）/ 下（滑）/ 空格（冲刺）。
	#
	# 这里用 _set_action 强制覆盖，而不是像下面那些那样"只补不禁"：
	#   旧的「空格 / W / J 也能跳」必须被**真的移除**，否则空格会同时挂在
	#   jump 和 dash 两个 action 上，满格时按空格到底算跳还是算冲刺就说不清了。
	_set_action("jump", [KEY_UP])
	_set_action("slide", [KEY_DOWN])
	_set_action("dash", [KEY_SPACE])
	_ensure_action("restart", [KEY_R])
	_ensure_action("debug_toggle", [KEY_F3])
	# 手感热调：不用改代码重开就能把动画调顺
	_ensure_action("tune_faster", [KEY_BRACKETLEFT])    # 跑步循环变快（腿转更快）
	_ensure_action("tune_slower", [KEY_BRACKETRIGHT])   # 跑步循环变慢
	_ensure_action("nudge_up", [KEY_APOSTROPHE])        # 当前动作整体上移
	_ensure_action("nudge_down", [KEY_SEMICOLON])       # 当前动作整体下移
	# 动画修复项的 A/B 对比开关（定稿后连同实现一起删掉）
	_ensure_action("toggle_fps_snap", [KEY_MINUS])      # 帧率吸附 开/关
	_ensure_action("toggle_uniform_h", [KEY_EQUAL])     # 帧身高统一 开/关
	# 主界面导航
	_ensure_action("menu_up", [KEY_UP, KEY_W])
	_ensure_action("menu_down", [KEY_DOWN, KEY_S])
	_ensure_action("menu_confirm", [KEY_ENTER, KEY_KP_ENTER, KEY_SPACE])
	# 设置界面调数值用（也接 A/D，和 WS 那对保持一致）
	_ensure_action("menu_left", [KEY_LEFT, KEY_A])
	_ensure_action("menu_right", [KEY_RIGHT, KEY_D])
	_ensure_action("back_to_menu", [KEY_ESCAPE])
	# 测试模式：手动调速（一路调到很慢就是逐帧慢放）
	_ensure_action("test_slower", [KEY_COMMA])
	_ensure_action("test_faster", [KEY_PERIOD])


## 强制设定某个 action 的按键集合：**先清空再添加**。
##
## 与 _ensure_action 的差别就是它会**移除**多余的键。游戏操作键必须精确 ——
## 只补不禁的话，历史上加过的键会永久留在 action 上（比如"空格 = 跳"），
## 于是新键（空格 = 冲刺）和它抢同一个物理键，行为取决于两个 action 谁先被读。
func _set_action(action: StringName, keys: Array) -> void:
	if not InputMap.has_action(action):
		InputMap.add_action(action)
	InputMap.action_erase_events(action)
	for k in keys:
		var ev := InputEventKey.new()
		ev.physical_keycode = k
		InputMap.action_add_event(action, ev)


func _ensure_action(action: StringName, keys: Array) -> void:
	if not InputMap.has_action(action):
		InputMap.add_action(action)
	var existing := InputMap.action_get_events(action)
	for k in keys:
		var already := false
		for e in existing:
			if e is InputEventKey and e.physical_keycode == k:
				already = true
				break
		if not already:
			var ev := InputEventKey.new()
			ev.physical_keycode = k
			InputMap.action_add_event(action, ev)


# ---------------------------------------------------------------- 由物理常量反推的运动包络
## 以下三个函数是「可解性」的数学依据。生成器不允许产出超出包络的地形，
## 所以理论上任意一段地形都只用「跳」或「滑」就能通过。

## 跳跃最高点（px）
func jump_apex_height() -> float:
	return jump_velocity * jump_velocity / (2.0 * gravity)


## 一次跳跃的总滞空时间（秒），已计入下落重力倍率
func jump_air_time() -> float:
	var rise := absf(jump_velocity) / gravity
	var fall := sqrt(2.0 * jump_apex_height() / (gravity * fall_gravity_mult))
	return rise + fall


## 一次跳跃的水平覆盖距离（px），按当前目标速度计算
func jump_distance(speed: float = -1.0) -> float:
	var s := speed if speed > 0.0 else run_speed_start
	return s * jump_air_time()
