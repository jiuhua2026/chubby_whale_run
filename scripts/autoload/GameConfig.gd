# ---------------------------------------------------------------- 摄像机
## 玩家在屏幕上的水平位置比例（0=最左）
const camera_player_screen_ratio := 0.30
## 纵向跟随平滑
const camera_y_smooth := 6.0

# ---------------------------------------------------------------- 动画
## 跑步动画跑完**一整个循环**时角色前进的距离（px）。
## 这是跑步动画唯一的调节旋钮，也是"脚会不会打滑"和"看起来卡不卡"的根源。
##
## 帧率不写死，而是由速度反推：fps = 速度 × 帧数 / run_cycle_px
##   —— 这样"走多远"和"动画播多少"严格同步，速度变化时不会跳帧。
##
## 调法：跑起来盯脚底，用 [ 和 ] 键**实时**调，不用改代码重开。
##   脚往后搓地（动画跟不上位移）→ 按 ] 调大
##   脚像在原地倒腾（腿转得太快）  → 按 [ 调小
## 换算关系：**fps = 速度 × 帧数 / run_cycle_px**，即
##   **每帧停留时间 = run_cycle_px / 速度**（与帧数无关的另一半在这里）。
##
## ⚠ **2026-09-26 二次修正：240 → 210。**
##   下面那条「舒适区是每帧 40~50ms」的判据**是不完整的**——它漏掉了显示刷新率。
##   60Hz 屏幕上，每帧停留必须是 1/60s 的**整数倍**，否则停留时长会在
##   n 个 / n+1 个显示帧之间来回交替，人眼读作 ~12Hz 的节拍抖动。
##
##   旧值 240 的实测：起步 470px/s → 23.5fps → 每帧 42.6ms = **2.55 个显示帧**，
##   交替模式 3,2,3,2…；满速 720 → 36fps → 1.67 个显示帧，交替模式 2,1,2,2,1…
##   ——整个速度区间恰好压在 1.67~2.55 这个**抖动最重**的窗口里。
##   "看着在 40~50ms 舒适区内"和"每帧停留恒定"是两件事，前者不能替代后者。
##
## 取 **210** 是为了让 470~720 全程吸附到同一档 **30fps**（恰好 2 个显示帧）：
##     raw(speed) = speed × 12 / 210 → 470 得 26.9、720 得 41.1，
##     两个端点离 30 都比离 20 / 60 近 ⇒ 全程零档位跳变、每帧时长绝对恒定。
##   20 ↔ 30 的分界落在 437.5 px/s（低于起步速度），所以正常跑动不会碰到它。
##   撞击掉速后恢复的那一段会依次经过 10→15→20→30，那是"加速感"，是想要的。
##
## 改这个值前先跑一遍档位体检，确认速度区间没跨档：
##     --headless --quit-after 30 -- --selftest --ladder
## 或者游戏里按 F3（同一个表会一起打印出来）。
##
## 当前 run 素材 = **8 帧**（2026-09-26 晚换的第五版分镜图）。
##
## ⚠ **同日四次修正：210 → 140 → 回到 210。**
##
##   **140 是错的，错在"锚错了量"。** 当时的想法是保住
##   「每帧前进距离 = rc / 帧数 = 17.5px」，让帧率档位行为与旧素材一致 ——
##   档位行为确实保住了，但**丢掉了「一个循环的时长」**：
##     旧 12 帧 @30fps → 循环 0.400s（5.0 步/s）
##     新  8 帧 @30fps → 循环 **0.267s（7.5 步/s）**  ← 快了 50%
##   而步幅并没有变小（腿部横向张合 旧 97px / 新 92px，实测比值 0.95）。
##   ⇒ 实机观感就是用户报的「腿倒腾得太快太碎」。
##
##   **正确该锚的是「循环时长」—— 也就是 rc 本身**（rc 的物理含义就是
##   "一个循环角色前进的距离"）。它应当保持 **210**：那是旧素材调好的值
##   （当时按"起步 470 时每步前进 94px ≈ 画面步幅 97px"定的）。于是：
##     8 帧 / 20fps = **0.400s**，与旧素材的 12 帧 / 30fps **完全相同** ✓
##
##   **代价（数学死结）**：要让 470~720 全程锁 20fps，需 fps_raw ∈ [17.5, 25]，
##   即 470 要求 rc ≤ 214.9、720 要求 rc ≥ 230.4 —— 矛盾
##   （速度区间 1.53 倍 > 20fps 档能容忍的 1.43 倍）。
##   ⇒ 必须把最高速度压到 **655**（run_speed_bonus_max 250 → 185，见该处注释），
##     并同步下调墙速上限（wall_speed_bonus_max 235 → 175）。
##
##   校验（rc = 210，8 帧）：fps_raw = 速度 × 8 / 210
##     470 → 17.90 ｜ 655 → 24.95   两端都落在 20fps 档 [17.5, 25] 内 ✓
##     20↔15 分界 = 459.4（低于起步）｜ 20↔30 分界 = 656.3（高于新上限）⇒ **零换档** ✓
##
##   📌 别把"降到 20fps"读成"变卡"：帧数从 12 减到 8，每一步本来就该播得更久。
##      20fps 是把**步频**调回旧手感，不是把画面放慢。
##      该盯的指标是 **帧数 / fps = 一个循环的时长**，现在它与旧素材一致。
##
## 参考区间（未吸附时的名义值）：210 = 当前（配 20fps）/ 140 = 上一版（已废弃）。
const run_cycle_px_default := 210.0
## 运行时可改，`[` `]` 键调
var run_cycle_px := run_cycle_px_default

# ---------------------------------------------------------------- 动画 · 帧率吸附
## 打开后，动画帧率会被吸附到「显示刷新率的整数分之一」上。
##
## 这是「跑起来鬼畜」的主力修复项：只有 刷新率/n（60Hz 上即 30 / 20 / 15fps）
## 才能让每帧停留严格恒定，不会在 n 和 n+1 个显示帧之间摆动。
## 代价是动画推进与位移不再严格同步（约有百分之几的对不齐），
## 在本作素材上完全看不出来（脚本来就没有地面接触相位）。
##
## `-` 键运行时开关，用来 A/B 对比。
var anim_fps_snap := true
## 档位切换迟滞比例。避免速度在档位边界附近反复横跳导致帧率抖动。
const anim_fps_hysteresis := 0.12
## 上一帧选中的档位，供迟滞使用。-1 表示还没有档位。
var _anim_fps_prev := -1.0


## 当前显示刷新率。取不到（无头 / 虚拟显示）就按 60Hz 算。
func anim_refresh_rate() -> float:
	var r := DisplayServer.screen_get_refresh_rate()
	if r < 30.0 or r > 360.0:
		r = 60.0
	return r


## 把原始帧率吸附到「刷新率 / n」（n = 1..12）里最近的一档。
##
## 为什么用暴力枚举而不是 round(刷新率 / 原始值)：
##   刷新率/n 关于 n 是凸的，round 会选错档。60Hz 上 24.5fps 为例，
##   round(60/24.5) = 2 → 给出 30fps，但 |24.5−20| = 4.5 < |24.5−30| = 5.5，
##   正确答案是 20fps。差一档就是每帧 2 个显示帧 vs 3 个，观感完全不同。
func snap_anim_fps(raw_fps: float) -> float:
	if not anim_fps_snap or raw_fps <= 0.0:
		_anim_fps_prev = -1.0
		return raw_fps
	var r := anim_refresh_rate()
	var best := r
	var best_d := INF
	for n in range(1, 13):
		var cand := r / float(n)
		var d := absf(cand - raw_fps)
		if d < best_d:
			best_d = d
			best = cand
	# 迟滞：旧档位只要不比新档位差太多（默认 12% 容差）就保持不动。
	#
	# ⚠ **但必须加一条「不得跨档保持」的约束（2026-09-26 晚补）。**
	#   滑铲时水平速度乘了 slide_speed_mult(1.06)，会短暂冲到速度上限的 1.06 倍
	#   （645 × 1.06 ≈ 684 → fps_raw 26.0 → 最近档是 30fps）。等滑铲结束、速度回落，
	#   fps_raw 降到 24.95 —— 单看 12% 容差它会**继续粘在 30fps 并且不再恢复**，
	#   表现就是「每次滑铲之后跑步动画突然快一档」。
	#   加上「prev 与 best 不得相差一个档位」（比例 1.4 / 0.7 之内）之后，
	#   这种瞬态污染会被立刻纠正；而真正的同档边界抖动（prev ≈ best）不受影响，
	#   迟滞的原始目的仍然成立。
	if _anim_fps_prev > 0.0 \
			and _anim_fps_prev <= best * 1.4 \
			and _anim_fps_prev >= best * 0.7 \
			and absf(raw_fps - _anim_fps_prev) \
				<= absf(raw_fps - best) * (1.0 + anim_fps_hysteresis):
		return _anim_fps_prev
	_anim_fps_prev = best
	return best


## 清掉吸附的「上一档」记忆。
## 档位体检会连续扫过整个速度区间，把迟滞状态写脏；
## 扫完必须清一次，否则下一帧的真实播放会拿着扫描的残留档位去比迟滞。
func reset_anim_fps_ladder() -> void:
	_anim_fps_prev = -1.0


